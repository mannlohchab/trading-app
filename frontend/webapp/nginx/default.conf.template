# Rendered by the nginx image's envsubst step at start-up (BACKEND_URL).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Keep the scheme the outer proxy saw (TLS usually ends at Traefik).
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Client IP for the backend's per-IP rate limits. Behind a proxy on a private network (e.g. Traefik
  # in Dokploy), take the address it saw from X-Forwarded-For; when exposed directly, the TCP peer.
  # The backend reads the last X-Forwarded-For entry (TRUSTED_PROXY_IP_HEADER=x-forwarded-for), so
  # forward exactly one: the resolved client address.
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;

  # Re-resolve the backend host (Docker DNS) instead of pinning the start-up address.
  resolver 127.0.0.11 valid=30s ipv6=off;
  set $backend ${BACKEND_URL};

  location /api/ {
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_ssl_server_name on;
    # AI and market streams stay open; don't buffer or time them out early.
    proxy_buffering off;
    proxy_read_timeout 1h;
    client_max_body_size 10m;
  }

  location = /health {
    proxy_pass $backend;
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
  }

  # Hashed build assets never change.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA: every other path is a client route.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
