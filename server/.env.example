PORT=4000
CLIENT_ORIGIN=http://localhost:8081
DATABASE_URL=./data/trading.db
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
DEFAULT_PAPER_BALANCE=1000000

# Angel One SmartAPI (primary; missing credentials or failed requests use Yahoo data)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Cloudflare Workers AI (backend only; keep the Cloudflare account on Workers Free)
# Dashboard > Workers AI > Use REST API > Create a Workers AI API Token
# Token needs Workers AI Read + Edit permissions for this account.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.2-3b-instruct

# Primary forex data (server only; never use an EXPO_PUBLIC key)
TWELVE_DATA_API_KEY=
# Per-process rolling credit ceilings; set to match your plan.
TWELVE_DATA_MINUTE_CREDITS=8
TWELVE_DATA_DAY_CREDITS=800
FOREX_POLL_MS=60000
FOREX_HISTORY_CACHE_MS=300000
# Binance public REST + WebSocket market data needs no API key.
