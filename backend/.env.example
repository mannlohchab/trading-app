PORT=4001
CLIENT_ORIGIN=http://localhost:8081
DATABASE_URL=postgres://trading:trading@localhost:5433/trading
DATABASE_POOL_MAX=10
# require | disable (defaults to require when NODE_ENV=production)
DATABASE_SSL=disable

# --- Auth (Better Auth) ---
# Required in production, 32+ random chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API (OAuth redirect URIs are <BETTER_AUTH_URL>/api/v1/auth/callback/<provider>)
BETTER_AUTH_URL=http://localhost:4001
# Origins allowed to call auth endpoints: web origins + the app's deep-link scheme
AUTH_TRUSTED_ORIGINS=http://localhost:8081,tradinggurukul://
# Optional; a provider is enabled only when both of its values are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# --- Phone OTP ---
# console prints codes to the log (development only; refused in production)
SMS_PROVIDER=console

# --- Networking ---
# Set ONLY behind a reverse proxy that sets it (x-forwarded-for, cf-connecting-ip, ...).
# Unset = use the TCP peer address; client-sent IP headers are ignored.
TRUSTED_PROXY_IP_HEADER=

# --- AI assistant (Cloudflare Workers AI) ---
# Without both values the assistant answers 503 AI_NOT_CONFIGURED (conversations still work).
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Model ids from src/modules/ai/infrastructure/model-registry.ts
AI_DEFAULT_MODEL=gpt-oss-120b
AI_FALLBACK_MODELS=llama-4-scout,mistral-small-3.1
# Per user, reset at 00:00 UTC
AI_DAILY_TURN_LIMIT=50
AI_DAILY_TOKEN_LIMIT=250000

# --- Backtesting ---
# bwrap (bubblewrap namespaces + kernel limits; required in production) | process (kernel limits only:
# allowed in production only with BACKTEST_SANDBOX_ISOLATED_CONTAINER=true)
BACKTEST_SANDBOX=bwrap
BACKTEST_SANDBOX_ISOLATED_CONTAINER=false
# Run the job runner in the API process; set false when running `bun run jobs` separately.
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOBS_CONCURRENCY=1

# --- Paper trading ---
# Run the paper-trading engine (live-quote fills, strategy scheduling) in this process. Enable in exactly one process.
PAPER_ENGINE_ENABLED=true

# --- Crypto news ---
# Free, key-less sources: publishers' RSS feeds and the Free Crypto News API (cryptocurrency.cv, 120 req/h free;
# each poll makes 2 requests + 1 per topic).
NEWS_RSS_ENABLED=true
NEWS_RSS_INTERVAL_MINUTES=10
NEWS_CRYPTOCURRENCY_CV_ENABLED=true
NEWS_CRYPTOCURRENCY_CV_INTERVAL_MINUTES=10
NEWS_CRYPTOCURRENCY_CV_TOPICS=bitcoin,ethereum,solana,xrp
# CryptoPanic is only polled when a key is set (https://cryptopanic.com/developers/api/).
CRYPTOPANIC_API_KEY=
NEWS_CRYPTOPANIC_INTERVAL_MINUTES=60
NEWS_RETENTION_DAYS=30

# --- Metrics ---
# Internal Prometheus endpoint (http://<host>:9464/metrics). Keep it off the public proxy. 0 disables it.
METRICS_PORT=9464
